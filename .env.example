DATABASE_PATH=codenest.sqlite3

# Keep this value stable between server restarts. Generate with:
# py -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set a unique, strong admin password before starting the server.
ADMIN_USERNAME=ADM
ADMIN_PASSWORD=
# Set true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Google OAuth: register http://127.0.0.1:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# GitHub OAuth: register http://127.0.0.1:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/auth/github/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=8592672929
ADMIN_APPROVAL_KEY=
TELEGRAM_CA_BUNDLE=
TELEGRAM_ALLOW_INSECURE_TLS=false
